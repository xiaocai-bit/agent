import torch
from torch import nn

from transformers import AutoModelForCausalLM
from transformers import AutoTokenizer

from peft import LoraConfig
from peft import get_peft_model


class LLMTokenEncoder(nn.Module):

    def __init__(self, llm_path, in_dim, device="cuda", llm_dtype="bf16"):
        super().__init__()

        self.tokenizer = AutoTokenizer.from_pretrained(llm_path, use_fast=True)
        self.text_prompt = "You are a battery SOH prediction model."

        prompt_ids = self.tokenizer(
            self.text_prompt,
            return_tensors="pt",
            add_special_tokens=False
        ).input_ids
        self.register_buffer("prompt_ids", prompt_ids, persistent=False)

        if llm_dtype.lower() == "bf16":
            dtype = torch.bfloat16
        elif llm_dtype.lower() == "fp16":
            dtype = torch.float16
        else:
            dtype = torch.float32

        llm = AutoModelForCausalLM.from_pretrained(
            llm_path,
            torch_dtype=dtype,
            device_map="auto" if str(device).startswith("cuda") else None
        )

        lora_config = LoraConfig(
            r=8,
            lora_alpha=16,
            target_modules=["q_proj", "v_proj"],
            lora_dropout=0.1,
            bias="none",
            task_type="CAUSAL_LM"
        )
        llm = get_peft_model(llm, lora_config)

        print("\n========================")
        print("LoRA Enabled")
        print("========================")
        llm.print_trainable_parameters()

        self.base = llm
        self.hidden_size = llm.config.hidden_size

        self.proj = nn.Linear(in_dim, self.hidden_size)
        self.proj = self.proj.to(dtype=next(llm.parameters()).dtype)

    def forward(self, x_tokens, attention_mask=None):
        proj_dtype = self.proj.weight.dtype
        proj_device = self.proj.weight.device

        x_tokens = x_tokens.to(device=proj_device, dtype=proj_dtype)
        x_emb = self.proj(x_tokens)

        p_ids = self.prompt_ids.to(device=proj_device).expand(x_emb.size(0), -1)
        tok_emb_layer = self.base.get_input_embeddings()
        prompt_emb = tok_emb_layer(p_ids)

        emb = torch.cat([prompt_emb.to(x_emb.dtype), x_emb], dim=1)

        B, T, _ = x_emb.shape
        P = prompt_emb.size(1)

        if attention_mask is None:
            attention_mask = torch.ones(B, T, device=proj_device, dtype=torch.long)

        prefix_mask = torch.ones(B, P, device=proj_device, dtype=torch.long)
        attn_mask = torch.cat([prefix_mask, attention_mask], dim=1)

        position_ids = torch.arange(P + T, device=proj_device).unsqueeze(0).expand(B, P + T)

        llm_dtype = next(self.base.parameters()).dtype
        emb = emb.to(dtype=llm_dtype)

        out = self.base(
            inputs_embeds=emb,
            attention_mask=attn_mask,
            position_ids=position_ids,
            use_cache=False,
            output_hidden_states=True
        )

        h = out.hidden_states[-1][:, P:, :]
        return h


class TSLLMModel(nn.Module):

    def __init__(
            self,
            input_dim=67,
            num_tokens=4,
            token_dim=128,
            llm_path="",
            dropout=0.1,
            device="cuda",
            llm_dtype="bf16"
    ):
        super().__init__()

        self.num_tokens = num_tokens
        self.token_dim = token_dim

        self.feature_tokenizer = nn.Sequential(
            nn.Linear(input_dim, num_tokens * token_dim),
            nn.GELU(),
            nn.Unflatten(1, (num_tokens, token_dim))
        )

        self.pre_llm_proj = nn.Sequential(
            nn.Linear(token_dim + 1, token_dim),
            nn.GELU(),
            nn.LayerNorm(token_dim)
        )

        self.llm_enc = LLMTokenEncoder(
            llm_path=llm_path,
            in_dim=token_dim,
            device=device,
            llm_dtype=llm_dtype
        )

        out_dim = self.llm_enc.hidden_size

        self.pool_attn = nn.Sequential(
            nn.Linear(out_dim, out_dim // 2),
            nn.Tanh(),
            nn.Linear(out_dim // 2, 1)
        )

        self.head = nn.Sequential(
            nn.LayerNorm(out_dim),
            nn.Linear(out_dim, out_dim // 2),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(out_dim // 2, 1)
        ).float()

    def forward(self, features, cycle_id, return_latent=False):
        ts_tokens = self.feature_tokenizer(features)

        cycle_tokens = cycle_id.unsqueeze(1).expand(-1, self.num_tokens, -1)
        ts_tokens = torch.cat([ts_tokens, cycle_tokens], dim=-1)
        ts_tokens = self.pre_llm_proj(ts_tokens)

        B, T, _ = ts_tokens.shape
        attn_mask = torch.ones(B, T, device=ts_tokens.device, dtype=torch.long)

        h = self.llm_enc(ts_tokens, attention_mask=attn_mask)

        h = h.to(dtype=next(self.pool_attn.parameters()).dtype)
        attn_score = self.pool_attn(h)
        attn_weight = torch.softmax(attn_score, dim=1)
        pooled = (h * attn_weight).sum(dim=1)

        pooled = pooled.to(dtype=next(self.head.parameters()).dtype)
        yhat = self.head(pooled).squeeze(-1)

        if return_latent:
            return yhat, pooled
        return yhat


class PhysicsNet(nn.Module):

    def __init__(self, latent_dim):
        super().__init__()
        in_dim = latent_dim + 2
        self.net = nn.Sequential(
            nn.LayerNorm(in_dim),
            nn.Linear(in_dim, latent_dim),
            nn.GELU(),
            nn.Linear(latent_dim, latent_dim // 2),
            nn.GELU(),
            nn.Linear(latent_dim // 2, 1)
        )

    def forward(self, h, soh, cycle):
        x = torch.cat([h, soh, cycle], dim=-1)
        return self.net(x).squeeze(-1)
