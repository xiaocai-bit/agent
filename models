"""Model definitions for battery SOH estimation.

This module intentionally keeps the four model classes as top-level siblings:
LLMTokenEncoder, TSLLMModel, CrossTemporalSOHModel, and PhysicsNet.  Keeping
them flat avoids partially registered modules and makes
``from models import CrossTemporalSOHModel`` reliable.
"""

import torch
from torch import nn

from transformers import AutoModelForCausalLM
from transformers import AutoTokenizer

from peft import LoraConfig
from peft import get_peft_model


__all__ = [
    "LLMTokenEncoder",
    "TSLLMModel",
    "CrossTemporalSOHModel",
    "PhysicsNet",
]


class LLMTokenEncoder(nn.Module):

    def __init__(self, llm_path, in_dim, device="cuda", llm_dtype="bf16"):
        super().__init__()

        self.tokenizer = AutoTokenizer.from_pretrained(llm_path, use_fast=True)
        self.text_prompt = "You are a battery SOH prediction model."

        prompt_ids = self.tokenizer(
            self.text_prompt,
            return_tensors="pt",
            add_special_tokens=False
        ).input_ids
        self.register_buffer("prompt_ids", prompt_ids, persistent=False)

        if llm_dtype.lower() == "bf16":
            dtype = torch.bfloat16
        elif llm_dtype.lower() == "fp16":
            dtype = torch.float16
        else:
            dtype = torch.float32

        llm = AutoModelForCausalLM.from_pretrained(
            llm_path,
            torch_dtype=dtype,
            device_map="auto" if str(device).startswith("cuda") else None
        )

        lora_config = LoraConfig(
            r=8,
            lora_alpha=16,
            target_modules=["q_proj", "v_proj"],
            lora_dropout=0.1,
            bias="none",
            task_type="CAUSAL_LM"
        )
        llm = get_peft_model(llm, lora_config)

        print("\n========================")
        print("LoRA Enabled")
        print("========================")
        llm.print_trainable_parameters()

        self.base = llm
        self.hidden_size = llm.config.hidden_size

        self.proj = nn.Linear(in_dim, self.hidden_size)
        self.proj = self.proj.to(dtype=next(llm.parameters()).dtype)

    def forward(self, x_tokens, attention_mask=None):
        proj_dtype = self.proj.weight.dtype
        proj_device = self.proj.weight.device

        x_tokens = x_tokens.to(device=proj_device, dtype=proj_dtype)
        x_emb = self.proj(x_tokens)

        p_ids = self.prompt_ids.to(device=proj_device).expand(x_emb.size(0), -1)
        tok_emb_layer = self.base.get_input_embeddings()
        prompt_emb = tok_emb_layer(p_ids)

        emb = torch.cat([prompt_emb.to(x_emb.dtype), x_emb], dim=1)

        B, T, _ = x_emb.shape
        P = prompt_emb.size(1)

        if attention_mask is None:
            attention_mask = torch.ones(B, T, device=proj_device, dtype=torch.long)

        prefix_mask = torch.ones(B, P, device=proj_device, dtype=torch.long)
        attn_mask = torch.cat([prefix_mask, attention_mask], dim=1)

        position_ids = torch.arange(P + T, device=proj_device).unsqueeze(0).expand(B, P + T)

        llm_dtype = next(self.base.parameters()).dtype
        emb = emb.to(dtype=llm_dtype)

        out = self.base(
            inputs_embeds=emb,
            attention_mask=attn_mask,
            position_ids=position_ids,
            use_cache=False,
            output_hidden_states=True
        )

        h = out.hidden_states[-1][:, P:, :]
        return h


class TSLLMModel(nn.Module):

    def __init__(
            self,
            input_dim=67,
            num_tokens=4,
            token_dim=128,
            llm_path="",
            dropout=0.1,
            device="cuda",
            llm_dtype="bf16"
    ):
        super().__init__()

        self.num_tokens = num_tokens
        self.token_dim = token_dim

        self.feature_tokenizer = nn.Sequential(
            nn.Linear(input_dim, num_tokens * token_dim),
            nn.GELU(),
            nn.Unflatten(1, (num_tokens, token_dim))
        )

        self.pre_llm_proj = nn.Sequential(
            nn.Linear(token_dim + 1, token_dim),
            nn.GELU(),
            nn.LayerNorm(token_dim)
        )

        self.llm_enc = LLMTokenEncoder(
            llm_path=llm_path,
            in_dim=token_dim,
            device=device,
            llm_dtype=llm_dtype
        )

        out_dim = self.llm_enc.hidden_size
        self.latent_dim = out_dim

        self.pool_attn = nn.Sequential(
            nn.Linear(out_dim, out_dim // 2),
            nn.Tanh(),
            nn.Linear(out_dim // 2, 1)
        )

        self.head = nn.Sequential(
            nn.LayerNorm(out_dim),
            nn.Linear(out_dim, out_dim // 2),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(out_dim // 2, 1)
        ).float()

    def encode_cycle(self, features, cycle_id):
        ts_tokens = self.feature_tokenizer(features)

        cycle_tokens = cycle_id.unsqueeze(1).expand(-1, self.num_tokens, -1)
        ts_tokens = torch.cat([ts_tokens, cycle_tokens], dim=-1)
        ts_tokens = self.pre_llm_proj(ts_tokens)

        B, T, _ = ts_tokens.shape
        attn_mask = torch.ones(B, T, device=ts_tokens.device, dtype=torch.long)

        h = self.llm_enc(ts_tokens, attention_mask=attn_mask)

        h = h.to(dtype=next(self.pool_attn.parameters()).dtype)
        attn_score = self.pool_attn(h)
        attn_weight = torch.softmax(attn_score, dim=1)
        pooled = (h * attn_weight).sum(dim=1)
        return pooled

    def predict_from_latent(self, latent):
        latent = latent.to(dtype=next(self.head.parameters()).dtype)
        return self.head(latent).squeeze(-1)

    def forward(self, features, cycle_id, return_latent=False):
        pooled = self.encode_cycle(features, cycle_id)
        yhat = self.predict_from_latent(pooled)

        if return_latent:
            return yhat, pooled
        return yhat


class CrossTemporalSOHModel(nn.Module):
    """Current-state and historical-degradation SOH estimator.

    The current branch encodes the handcrafted feature vector of cycle ``t`` as
    ``z_t``.  The historical branch reuses the same cycle encoder on the latest
    ``K`` cycles, aggregates their latent states with a Transformer, and learns
    a generator ``g(z_h)`` that reconstructs the current health-state
    representation.  This implements the cross-temporal constraint
    ``||z_t - g(z_h)||^2`` without claiming access to raw fine-scale signals.
    """

    def __init__(self, backbone, history_len=10, num_layers=1, num_heads=4, dropout=0.1):
        super().__init__()
        self.backbone = backbone
        self.history_len = history_len
        hidden_size = backbone.llm_enc.hidden_size
        self.latent_dim = hidden_size

        encoder_layer = nn.TransformerEncoderLayer(
            d_model=hidden_size,
            nhead=num_heads,
            dim_feedforward=hidden_size * 2,
            dropout=dropout,
            activation="gelu",
            batch_first=True,
            norm_first=True
        )
        self.history_encoder = nn.TransformerEncoder(
            encoder_layer,
            num_layers=num_layers
        )

        self.history_head = nn.Sequential(
            nn.LayerNorm(hidden_size),
            nn.Linear(hidden_size, hidden_size // 2),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_size // 2, 1)
        ).float()

        self.generator = nn.Sequential(
            nn.LayerNorm(hidden_size),
            nn.Linear(hidden_size, hidden_size),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_size, hidden_size)
        ).float()

    @property
    def llm_enc(self):
        return self.backbone.llm_enc

    def encode_history(self, history_features, history_cycle_id):
        B, K, D = history_features.shape
        flat_features = history_features.reshape(B * K, D)
        flat_cycle = history_cycle_id.reshape(B * K, -1)

        flat_latent = self.backbone.encode_cycle(flat_features, flat_cycle)
        history_latent = flat_latent.reshape(B, K, -1)
        history_latent = history_latent.to(dtype=next(self.history_encoder.parameters()).dtype)

        encoded = self.history_encoder(history_latent)
        return encoded[:, -1, :]

    def forward(
            self,
            features,
            cycle_id,
            history_features=None,
            history_cycle_id=None,
            return_latent=False,
            return_cross_temporal=False
    ):
        y_current, z_current = self.backbone(
            features,
            cycle_id,
            return_latent=True
        )

        if history_features is None or history_cycle_id is None:
            if return_latent:
                return y_current, z_current
            return y_current

        z_history = self.encode_history(history_features, history_cycle_id)
        z_history = z_history.to(dtype=next(self.history_head.parameters()).dtype)
        y_history = self.history_head(z_history).squeeze(-1)
        z_hat_current = self.generator(z_history)

        if return_cross_temporal:
            return {
                "pred_current": y_current,
                "pred_history": y_history,
                "z_current": z_current,
                "z_history": z_history,
                "z_hat_current": z_hat_current
            }

        if return_latent:
            return y_current, z_current
        return y_current


class PhysicsNet(nn.Module):

    def __init__(self, latent_dim):
        super().__init__()
        in_dim = latent_dim + 2
        self.net = nn.Sequential(
            nn.LayerNorm(in_dim),
            nn.Linear(in_dim, latent_dim),
            nn.GELU(),
            nn.Linear(latent_dim, latent_dim // 2),
            nn.GELU(),
            nn.Linear(latent_dim // 2, 1)
        )

    def forward(self, h, soh, cycle):
        x = torch.cat([h, soh, cycle], dim=-1)
        return self.net(x).squeeze(-1)
