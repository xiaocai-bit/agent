from scipy.io import loadmat
import numpy as np
import pandas as pd
import torch

from torch.utils.data import (
    TensorDataset,
    DataLoader
)

from sklearn.model_selection import train_test_split

import os

import matplotlib.pyplot as plt

from utils.Scaler import Scaler


class MITDdataset():

    def __init__(self, args):

        super(MITDdataset).__init__()

        self.root = 'data/MIT'

        self.max_capacity = 1.1

        self.normalized_type = args.normalized_type

        self.minmax_range = args.minmax_range

        self.seed = args.random_seed

        self.batch = args.batch

        self.batch_size = args.batch_size

        if self.batch > 9:

            raise IndexError(
                f'"batch" must be in the [1, 9], but got {self.batch}. '
            )

    # =====================================================
    # MAT parser
    # =====================================================
    def _parser_mat_data(self, battery_i_mat):

        data = []

        label = []

        cycle_index = []

        for i in range(battery_i_mat.shape[1]):

            cycle_i_data = battery_i_mat[0, i]

            time = cycle_i_data['relative_time_min']

            current = cycle_i_data['current_A']

            voltage = cycle_i_data['voltage_V']

            temperature = cycle_i_data['temperature_C']

            capacity = cycle_i_data['capacity'][0]

            label.append(capacity)

            cycle_i = np.concatenate(
                [time, current, voltage, temperature],
                axis=0
            )

            data.append(cycle_i)

            cycle_index.append(i)

        data = np.array(
            data,
            dtype=np.float32
        )

        label = np.array(
            label,
            dtype=np.float32
        ).reshape(-1, 1)

        cycle_index = np.array(
            cycle_index,
            dtype=np.float32
        ).reshape(-1, 1)

        # normalize cycle index
        cycle_index = cycle_index / (
                len(cycle_index) - 1 + 1e-8
        )

        scaler = Scaler(data)

        if self.normalized_type == 'standard':

            data = scaler.standerd()

        else:

            data = scaler.minmax(
                feature_range=self.minmax_range
            )

        soh = label / self.max_capacity

        return data, soh, cycle_index

    # =====================================================
    # XLSX parser
    # =====================================================
    def _parser_xlsx(self, df_i):

        N = df_i.shape[0]

        # artificial degradation coordinate
        cycle_index = np.arange(
            N,
            dtype=np.float32
        ).reshape(-1, 1)

        # normalize to [0,1]
        cycle_index = cycle_index / (
                N - 1 + 1e-8
        )

        x = np.array(
            df_i.iloc[:, :-1],
            dtype=np.float32
        )

        label = np.array(
            df_i['label'],
            dtype=np.float32
        ).reshape(-1, 1)

        scaler = Scaler(x)

        if self.normalized_type == 'standard':

            data = scaler.standerd()

        else:

            data = scaler.minmax(
                feature_range=self.minmax_range
            )

        soh = label / self.max_capacity

        return data, soh, cycle_index

    # =====================================================
    # encapsulation
    # =====================================================
    def _encapsulation(

            self,

            train_x,
            train_y,
            train_cycle,

            test_x,
            test_y,
            test_cycle
    ):

        train_x = torch.from_numpy(train_x)

        train_y = torch.from_numpy(train_y)

        train_cycle = torch.from_numpy(train_cycle)

        test_x = torch.from_numpy(test_x)

        test_y = torch.from_numpy(test_y)

        test_cycle = torch.from_numpy(test_cycle)

        (
            train_x,
            valid_x,

            train_y,
            valid_y,

            train_cycle,
            valid_cycle

        ) = train_test_split(

            train_x,
            train_y,
            train_cycle,

            test_size=0.2,

            random_state=self.seed
        )

        train_loader = DataLoader(

            TensorDataset(
                train_x,
                train_y,
                train_cycle
            ),

            batch_size=self.batch_size,

            shuffle=True,

            drop_last=False
        )

        valid_loader = DataLoader(

            TensorDataset(
                valid_x,
                valid_y,
                valid_cycle
            ),

            batch_size=self.batch_size,

            shuffle=False,

            drop_last=False
        )

        test_loader = DataLoader(

            TensorDataset(
                test_x,
                test_y,
                test_cycle
            ),

            batch_size=self.batch_size,

            shuffle=False
        )

        return train_loader, valid_loader, test_loader

    # =====================================================
    # raw mat data
    # =====================================================
    def _get_raw_data(self, path, test_battery_id):

        mat = loadmat(path)

        battery = mat['battery']

        battery_ids = list(
            range(1, battery.shape[1] + 1)
        )

        if test_battery_id not in battery_ids:

            raise IndexError(
                f'"test_battery" must be in the {battery_ids}, '
                f'but got {test_battery_id}. '
            )

        # =================================================
        # test battery
        # =================================================
        test_battery = battery[
            0,
            test_battery_id - 1
        ][0]

        test_x, test_y, test_cycle = \
            self._parser_mat_data(test_battery)

        print(
            f'test battery id: {test_battery_id}, '
            f'test data shape:{test_x.shape}, {test_y.shape}'
        )

        # =================================================
        # train battery
        # =================================================
        train_x = []

        train_y = []

        train_cycle = []

        for id in battery_ids:

            if id == test_battery_id:
                continue

            print(f'train battery id: {id}')

            train_battery = battery[
                0,
                id - 1
            ][0]

            x, y, cycle = self._parser_mat_data(
                train_battery
            )

            train_x.append(x)

            train_y.append(y)

            train_cycle.append(cycle)

        train_x = np.concatenate(
            train_x,
            axis=0
        )

        train_y = np.concatenate(
            train_y,
            axis=0
        )

        train_cycle = np.concatenate(
            train_cycle,
            axis=0
        )

        print(
            'train data shape: ',
            train_x.shape,
            train_y.shape,
            train_cycle.shape
        )

        return self._encapsulation(

            train_x,
            train_y,
            train_cycle,

            test_x,
            test_y,
            test_cycle
        )

    # =====================================================
    # charge data
    # =====================================================
    def get_charge_data(self, test_battery_id=1):

        print('----------- load charge data -------------')

        charge_files = os.listdir(
            os.path.join(self.root, 'charge')
        )

        file_name = charge_files[self.batch - 1]

        self.charge_path = os.path.join(
            self.root,
            'charge',
            file_name
        )

        train_loader, valid_loader, test_loader = \
            self._get_raw_data(

                path=self.charge_path,

                test_battery_id=test_battery_id
            )

        data_dict = {

            'train': train_loader,

            'test': test_loader,

            'valid': valid_loader
        }

        print('-------------  finished !  ---------------')

        return data_dict

    # =====================================================
    # partial charge
    # =====================================================
    def get_partial_data(self, test_battery_id=1):

        print(
            '----------- load partial_charge data -------------'
        )

        charge_files = os.listdir(
            os.path.join(
                self.root,
                'partial_charge'
            )
        )

        file_name = charge_files[self.batch - 1]

        self.partial_path = os.path.join(
            self.root,
            'partial_charge',
            file_name
        )

        train_loader, valid_loader, test_loader = \
            self._get_raw_data(

                path=self.partial_path,

                test_battery_id=test_battery_id
            )

        data_dict = {

            'train': train_loader,

            'test': test_loader,

            'valid': valid_loader
        }

        print(
            '----------------  finished !  --------------------'
        )

        return data_dict

    # =====================================================
    # handcrafted features
    # =====================================================
    def get_features(self, test_battery_id=1):

        print('----------- load features -------------')

        charge_files = os.listdir(
            os.path.join(
                self.root,
                'handcraft_features'
            )
        )

        file_name = charge_files[self.batch - 1]

        self.features_path = os.path.join(

            self.root,

            'handcraft_features',

            file_name
        )

        df = pd.read_excel(

            self.features_path,

            sheet_name=None
        )

        sheet_names = list(df.keys())

        battery_ids = list(
            range(1, len(sheet_names) + 1)
        )

        if test_battery_id not in battery_ids:

            raise IndexError(
                f'"test_battery" must be in the {battery_ids}, '
                f'but got {test_battery_id}. '
            )

        # =================================================
        # test battery
        # =================================================
        test_battery_df = pd.read_excel(

            self.features_path,

            sheet_name=test_battery_id - 1,

            header=0
        )

        test_x, test_y, test_cycle = \
            self._parser_xlsx(test_battery_df)

        print(

            f'test battery id: {test_battery_id}, '

            f'test data shape: {test_x.shape}, '

            f'{test_y.shape}'
        )

        # =================================================
        # train battery
        # =================================================
        train_x = []

        train_y = []

        train_cycle = []

        for id in battery_ids:

            if id == test_battery_id:
                continue

            sheet_name = sheet_names[id - 1]

            df_i = df[sheet_name]

            x, y, cycle = self._parser_xlsx(df_i)

            print(
                f'train battery id: {id}, '
                f'{x.shape}, {y.shape}, {cycle.shape}'
            )

            train_x.append(x)

            train_y.append(y)

            train_cycle.append(cycle)

        train_x = np.concatenate(
            train_x,
            axis=0
        )

        train_y = np.concatenate(
            train_y,
            axis=0
        )

        train_cycle = np.concatenate(
            train_cycle,
            axis=0
        )

        print(
            'train data shape: ',
            train_x.shape,
            train_y.shape,
            train_cycle.shape
        )

        train_loader, valid_loader, test_loader = \
            self._encapsulation(

                train_x,
                train_y,
                train_cycle,

                test_x,
                test_y,
                test_cycle
            )

        data_dict = {

            'train': train_loader,

            'test': test_loader,

            'valid': valid_loader
        }

        print(
            '---------------  finished !  ----------------'
        )

        return data_dict


