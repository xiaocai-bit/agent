import math
from typing import Dict, Tuple

import torch
from torch import nn
import torch.nn.functional as F


class DAGMM(nn.Module):
    """LSTM-AE + DAGMM for sequence anomaly detection."""

    def __init__(
        self,
        input_dim: int,
        latent_dim: int = 64,
        n_gmm: int = 4,
        seq_len: int = 128,
        feature_dim: int = 8,
        lstm_layers: int = 2,
        estimation_hidden_dim: int = 32,
        dropout: float = 0.1,
        cnn_hidden_dim: int = 32,
        eps: float = 1e-12,
    ):
        super().__init__()
        self.input_dim = input_dim
        self.latent_dim = latent_dim
        self.n_gmm = n_gmm
        self.seq_len = seq_len
        self.feature_dim = feature_dim
        self.eps = eps

        self.feature_extractor = nn.Sequential(
            nn.Conv1d(feature_dim, cnn_hidden_dim, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.Conv1d(cnn_hidden_dim, feature_dim, kernel_size=3, padding=1),
            nn.ReLU(),
        )


        self.encoder = nn.LSTM(
            input_size=feature_dim,
            hidden_size=latent_dim,
            num_layers=lstm_layers,
            batch_first=True,
        )
        self.decoder = nn.LSTM(
            input_size=latent_dim,
            hidden_size=latent_dim,
            num_layers=lstm_layers,
            batch_first=True,
        )
        self.output_layer = nn.Linear(latent_dim, feature_dim)

        joint_dim = latent_dim + 1
        self.estimation = nn.Sequential(
            nn.Linear(joint_dim, estimation_hidden_dim),
            nn.Tanh(),
            nn.Dropout(dropout),
            nn.Linear(estimation_hidden_dim, n_gmm),
            nn.Softmax(dim=1),
        )

    def forward(self, x: torch.Tensor) -> Dict[str, torch.Tensor]:
        x_feat = self.feature_extractor(x.transpose(1, 2)).transpose(1, 2)
        _, (h_n, c_n) = self.encoder(x_feat)
        z_c = h_n[-1]

        decoder_input = z_c.unsqueeze(1).repeat(1, self.seq_len, 1)
        dec_out, _ = self.decoder(decoder_input, (h_n, c_n))
        x_hat = self.output_layer(dec_out)

        rec_error = ((x_feat - x_hat) ** 2).mean(dim=(1, 2), keepdim=True)
        rec_error = rec_error.view(-1, 1)

        z = torch.cat([z_c, rec_error], dim=1)
        gamma = self.estimation(z)
        phi, mu, cov = self.compute_gmm_params(z, gamma)
        energy = self.compute_energy(z, phi, mu, cov)

        return {
            "x_hat": x_hat,
            "x_feat": x_feat,
            "z_c": z_c,
            "rec_error": rec_error,
            "z": z,
            "gamma": gamma,
            "phi": phi,
            "mu": mu,
            "cov": cov,
            "energy": energy,
        }

    def compute_gmm_params(self, z: torch.Tensor, gamma: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        batch_size = z.size(0)
        gamma_sum = gamma.sum(dim=0).clamp_min(self.eps)
        phi = gamma_sum / batch_size
        mu = gamma.t().matmul(z) / gamma_sum.unsqueeze(1)

        z_centered = z.unsqueeze(1) - mu.unsqueeze(0)
        cov = torch.einsum("bk,bkd,bke->kde", gamma, z_centered, z_centered) / gamma_sum.view(-1, 1, 1)

        eye = torch.eye(z.size(1), device=z.device, dtype=z.dtype).unsqueeze(0)
        cov = cov + eye * self.eps
        return phi, mu, cov

    def compute_energy(self, z: torch.Tensor, phi: torch.Tensor, mu: torch.Tensor, cov: torch.Tensor) -> torch.Tensor:
        z_dim = z.size(1)
        eye = torch.eye(z_dim, device=z.device, dtype=z.dtype).unsqueeze(0)
        cov = cov + eye * self.eps

        precision = torch.linalg.pinv(cov)
        _, logabsdet = torch.linalg.slogdet(cov)
        z_centered = z.unsqueeze(1) - mu.unsqueeze(0)
        mahalanobis = torch.einsum("bkd,kde,bke->bk", z_centered, precision, z_centered)
        log_prob = (
            torch.log(phi.clamp_min(self.eps)).unsqueeze(0)
            - 0.5 * (z_dim * math.log(2 * math.pi) + logabsdet.unsqueeze(0) + mahalanobis)
        )
        return -torch.logsumexp(log_prob, dim=1)

    def loss(
        self,
        x: torch.Tensor,
        outputs: Dict[str, torch.Tensor],
        lambda_energy: float = 0.1,
        lambda_cov: float = 0.005,
    ) -> Tuple[torch.Tensor, Dict[str, torch.Tensor]]:
        rec_loss = F.mse_loss(outputs["x_hat"], outputs["x_feat"].detach())
        energy_loss = outputs["energy"].mean()
        cov_diag = torch.diagonal(outputs["cov"], dim1=1, dim2=2)
        cov_loss = torch.mean(1.0 / cov_diag.clamp_min(self.eps))
        total_loss = rec_loss + lambda_energy * energy_loss + lambda_cov * cov_loss
        return total_loss, {
            "total": total_loss,
            "reconstruction": rec_loss,
            "energy": energy_loss,
            "covariance": cov_loss,
        }


def add_gaussian_noise(x: torch.Tensor, std: float) -> torch.Tensor:
    if std <= 0:
        return x
    return x + torch.randn_like(x) * std
