import math
from typing import Dict, Tuple

import torch
from torch import nn
import torch.nn.functional as F


class DAGMM(nn.Module):
    """Deep Autoencoding Gaussian Mixture Model for uncertainty scoring.

    The module follows the DAGMM pipeline described for Task 2:
    1. encode the input feature vector x into a compact code z_c;
    2. reconstruct x as x_hat;
    3. append reconstruction quality features z_r and z_e;
    4. estimate GMM memberships gamma for the joint representation z;
    5. compute GMM parameters and sample energy scores.
    """

    def __init__(
        self,
        input_dim: int,
        latent_dim: int = 8,
        n_gmm: int = 4,
        hidden_dims: Tuple[int, ...] = (128, 64),
        estimation_hidden_dim: int = 32,
        dropout: float = 0.1,
        eps: float = 1e-12,
    ):
        super().__init__()
        self.input_dim = input_dim
        self.latent_dim = latent_dim
        self.n_gmm = n_gmm
        self.eps = eps

        encoder_layers = []
        prev_dim = input_dim
        for hidden_dim in hidden_dims:
            encoder_layers.extend([
                nn.Linear(prev_dim, hidden_dim),
                nn.Tanh(),
            ])
            prev_dim = hidden_dim
        encoder_layers.append(nn.Linear(prev_dim, latent_dim))
        self.encoder = nn.Sequential(*encoder_layers)

        decoder_layers = []
        prev_dim = latent_dim
        for hidden_dim in reversed(hidden_dims):
            decoder_layers.extend([
                nn.Linear(prev_dim, hidden_dim),
                nn.Tanh(),
            ])
            prev_dim = hidden_dim
        decoder_layers.append(nn.Linear(prev_dim, input_dim))
        self.decoder = nn.Sequential(*decoder_layers)

        joint_dim = latent_dim + 2
        self.estimation = nn.Sequential(
            nn.Linear(joint_dim, estimation_hidden_dim),
            nn.Tanh(),
            nn.Dropout(dropout),
            nn.Linear(estimation_hidden_dim, n_gmm),
            nn.Softmax(dim=1),
        )

    def forward(self, x: torch.Tensor) -> Dict[str, torch.Tensor]:
        """Return reconstruction, joint latent vector, memberships, and GMM terms."""
        z_c = self.encoder(x)
        x_hat = self.decoder(z_c)
        z_r, z_e = self.reconstruction_features(x, x_hat)
        z = torch.cat([z_c, z_r, z_e], dim=1)
        gamma = self.estimation(z)
        phi, mu, cov = self.compute_gmm_params(z, gamma)
        energy = self.compute_energy(z, phi, mu, cov)

        return {
            "x_hat": x_hat,
            "z_c": z_c,
            "z_r": z_r,
            "z_e": z_e,
            "z": z,
            "gamma": gamma,
            "phi": phi,
            "mu": mu,
            "cov": cov,
            "energy": energy,
        }

    def reconstruction_features(
        self,
        x: torch.Tensor,
        x_hat: torch.Tensor,
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        """Compute z_r as relative Euclidean error and z_e as cosine similarity."""
        euclidean = torch.norm(x - x_hat, p=2, dim=1, keepdim=True)
        denominator = torch.norm(x, p=2, dim=1, keepdim=True).clamp_min(self.eps)
        z_r = euclidean / denominator
        z_e = F.cosine_similarity(x, x_hat, dim=1, eps=self.eps).unsqueeze(1)
        return z_r, z_e

    def compute_gmm_params(
        self,
        z: torch.Tensor,
        gamma: torch.Tensor,
    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        """Estimate mixture weights, component means, and covariances from a batch."""
        batch_size = z.size(0)
        gamma_sum = gamma.sum(dim=0).clamp_min(self.eps)
        phi = gamma_sum / batch_size
        mu = gamma.t().matmul(z) / gamma_sum.unsqueeze(1)

        z_centered = z.unsqueeze(1) - mu.unsqueeze(0)
        cov = torch.einsum(
            "bk,bkd,bke->kde",
            gamma,
            z_centered,
            z_centered,
        ) / gamma_sum.view(-1, 1, 1)

        eye = torch.eye(z.size(1), device=z.device, dtype=z.dtype).unsqueeze(0)
        cov = cov + eye * self.eps
        return phi, mu, cov

    def compute_energy(
        self,
        z: torch.Tensor,
        phi: torch.Tensor,
        mu: torch.Tensor,
        cov: torch.Tensor,
    ) -> torch.Tensor:
        """Compute the negative log likelihood under the learned GMM."""
        z_dim = z.size(1)
        eye = torch.eye(z_dim, device=z.device, dtype=z.dtype).unsqueeze(0)
        cov = cov + eye * self.eps

        precision = torch.linalg.pinv(cov)
        _, logabsdet = torch.linalg.slogdet(cov)
        z_centered = z.unsqueeze(1) - mu.unsqueeze(0)
        mahalanobis = torch.einsum(
            "bkd,kde,bke->bk",
            z_centered,
            precision,
            z_centered,
        )
        log_prob = (
            torch.log(phi.clamp_min(self.eps)).unsqueeze(0)
            - 0.5 * (z_dim * math.log(2 * math.pi) + logabsdet.unsqueeze(0) + mahalanobis)
        )
        return -torch.logsumexp(log_prob, dim=1)

    def loss(
        self,
        x: torch.Tensor,
        outputs: Dict[str, torch.Tensor],
        lambda_energy: float = 0.1,
        lambda_cov: float = 0.005,
    ) -> Tuple[torch.Tensor, Dict[str, torch.Tensor]]:
        """Compute L_conf = L_rec + lambda_1 L_energy + lambda_2 L_cov."""
        rec_loss = F.mse_loss(outputs["x_hat"], x.detach())
        energy_loss = outputs["energy"].mean()
        cov_diag = torch.diagonal(outputs["cov"], dim1=1, dim2=2)
        cov_loss = torch.mean(1.0 / cov_diag.clamp_min(self.eps))
        total_loss = rec_loss + lambda_energy * energy_loss + lambda_cov * cov_loss
        parts = {
            "total": total_loss,
            "reconstruction": rec_loss,
            "energy": energy_loss,
            "covariance": cov_loss,
        }
        return total_loss, parts


def add_gaussian_noise(x: torch.Tensor, std: float) -> torch.Tensor:
    """Simulate environmental/manufacturing shifts with additive Gaussian noise."""
    if std <= 0:
        return x
    return x + torch.randn_like(x) * std
